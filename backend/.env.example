# MongoDB Atlas / MongoDB server connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=heng_charoen_fuel_system

# Generate a long random secret before production deployment
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_SECONDS=604800

# Upload and CORS settings
UPLOAD_MAX_MB=200
UPLOAD_DB_MAX_MB=10
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
PORT=3000
APP_TIMEZONE=Asia/Bangkok
